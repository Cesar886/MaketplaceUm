<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="mercadito_um"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link de vuelta desde el navegador tras conectar la
                 cuenta de Mercado Pago (mercaditoum://payments/connected).
                 El OAuth se abre en el navegador del sistema, no en un
                 WebView: ahí el vendedor escribe sus credenciales de Mercado
                 Pago y necesita poder ver la barra de direcciones real.
                 El esquema debe coincidir con APP_DEEP_LINK_SCHEME del
                 backend (.env). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mercaditoum" android:host="payments"/>
            </intent-filter>
            <!-- App Links: los links compartidos de una publicación
                 (https://mercaditoum.site/producto/<id>) abren la app directo,
                 sin pasar por el navegador y sin preguntarle al usuario.

                 android:autoVerify="true" es lo que elimina el diálogo de
                 "¿con qué app abrir?": al instalar, Android descarga
                 https://mercaditoum.site/.well-known/assetlinks.json y solo
                 concede el link si la huella SHA-256 de ahí coincide con la
                 del certificado que firmó ESTE APK. Si no coincide (o la
                 lista está vacía), no hay error visible: el link simplemente
                 abre el navegador y cae en la versión web, que es el fallback
                 buscado.

                 El pathPrefix acota la captura al detalle de una publicación.
                 Sin él la app se quedaría también con la home y con cualquier
                 página futura del sitio, que deben seguir abriendo en el
                 navegador.

                 Va en un intent-filter aparte del de Mercado Pago a
                 propósito: autoVerify aplica a TODOS los hosts http/https del
                 mismo filtro, y mezclarlos haría que un fallo de verificación
                 arrastrara al otro deep link.

                 Para verificar en un dispositivo:
                   adb shell pm get-app-links com.example.mercadito_um
                   adb shell am start -a android.intent.action.VIEW \
                     -d "https://mercaditoum.site/producto/<id>" -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="mercaditoum.site"
                      android:pathPrefix="/producto/"/>
                <!-- Solo el host desnudo. `www.mercaditoum.site` es un dominio
                     DISTINTO para la verificación y necesitaría su propio
                     assetlinks.json; agregarlo aquí sin eso haría fallar la
                     verificación del filtro entero en Android 11 y anteriores,
                     donde es todo-o-nada entre los hosts de un mismo filtro. -->
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
            
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mercadito_um_default" />
        <!-- Ícono que Android usa en la barra de estado. Debe ser una
             silueta blanca sobre transparente (drawable-*/ic_notification.png):
             un ícono a color, como el launcher, se reemplaza por un
             blob genérico porque Android solo puede pintar el canal alfa. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
</manifest>
