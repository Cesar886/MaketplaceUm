[Unit]
Description=Respaldo verificado de PostgreSQL para Marketplace UM
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/mercaditoUmBack
Environment=MERCADITO_BACKUP_RETENTION_DAYS=14
ExecStart=/root/mercaditoUmBack/infra/postgres/backup.sh
UMask=0077
Nice=10

[Install]
WantedBy=multi-user.target
