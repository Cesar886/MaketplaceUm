# Copia este archivo a backend/.env y rellena los valores reales.
# backend/.env está en .gitignore y nunca debe commitearse.

# ─── PostgreSQL ───────────────────────────────────────────────
# Usuario de ejecución con permisos sólo de SELECT/INSERT/UPDATE/DELETE. En
# producción NO uses postgres ni marketplace_migrator aquí. Si la contraseña
# contiene símbolos reservados de URL, codifícala con percent-encoding.
DATABASE_URL=postgresql://marketplace_app:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/marketplace_um
PGSCHEMA=public

# PostgreSQL del mismo host escucha sólo en loopback y no necesita TLS en ese
# salto. Si la base vive en otra máquina, PGSSL=true y PGSSL_CA_FILE son
# obligatorios en producción; no se permite rejectUnauthorized=false.
PGSSL=false
# PGSSL_CA_FILE=/ruta/ca-postgresql.pem

# Límites defensivos: evitan conexiones ilimitadas y consultas colgadas.
PGPOOL_MIN=1
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000

# Producción verifica migraciones, pero el usuario de la app no puede crear
# tablas. Para desplegar, ejecuta `npm run db:migrate` pasando temporalmente
# DATABASE_URL del rol marketplace_migrator en el entorno del comando.
PG_RUN_MIGRATIONS=false

# ─── Sesión ───────────────────────────────────────────────────
# En producción es OBLIGATORIO definirlo con al menos 32 caracteres.
JWT_SECRET=

# Origenes web autorizados para REST y Socket.IO, separados por coma. Las apps
# moviles (sin cabecera Origin) siguen funcionando. En produccion incluye solo
# el dominio HTTPS real, nunca "*".
ALLOWED_ORIGINS=https://tu-dominio.example

# Numero de proxies inversos confiables delante de Node (normalmente 1 con
# Nginx/Cloudflare Tunnel). Dejalo vacio si Node recibe internet directamente.
TRUST_PROXY=

# ─── Panel administrativo ─────────────────────────────────────
# Origen HTTPS exacto desde el que el BFF del panel llama /api/admin/*. No se
# admiten comodines, otros origenes ni requests sin Origin en este namespace.
ADMIN_PANEL_ORIGIN=https://marketplace-um.me

# Secreto exclusivo para JWT administrativos. No reutilices JWT_SECRET ni la
# llave REVISION_API_KEY. Ambos secretos siguientes deben tener >=32 caracteres.
ADMIN_JWT_SECRET=

# Cifra con AES-256-GCM la semilla TOTP dentro de PostgreSQL y sus backups.
ADMIN_TOTP_ENCRYPTION_KEY=

# Secreto compartido exclusivamente entre el BFF Next y Express para firmar
# la IP que usa el rate limiter. Debe ser distinto de todos los anteriores.
ADMIN_BFF_SHARED_SECRET=

# Cuenta real de la app desde la que se envian, solo cuando el administrador
# lo elige, las respuestas de chat a quienes hicieron un reporte. El remitente
# se resuelve en el servidor por este correo y nunca se acepta desde el cliente.
REPORTS_ACCOUNT_EMAIL=

# Express escucha solo en loopback por defecto para que Apache sea la unica
# entrada publica. Cambialo únicamente si la API debe exponerse en otra
# interfaz y ya existe un firewall equivalente delante.
API_BIND_HOST=127.0.0.1

# Variables efimeras usadas solo por `npm run admin:create`. Define una clave
# de 14-72 bytes UTF-8, ejecuta el comando en el servidor, escanea el QR y
# elimina ambas variables inmediatamente; nunca las dejes en este archivo.
# ADMIN_CREATE_USERNAME=
# ADMIN_CREATE_PASSWORD=

# ─── Verificación de estudiantes ──────────────────────────────
# Dominios de correo institucional aceptados, separados por coma.
# El correo debe ser <7 dígitos>@<dominio>, ej. 1220326@alumno.um.edu.mx
VERIFICATION_STUDENT_DOMAINS=alumno.um.edu.mx

# ─── Envío de email (OTP de estudiante) ───────────────────────
# Si faltan estas variables:
#   - en desarrollo el código se imprime en consola y se devuelve como
#     `codigo_dev` en la respuesta del endpoint;
#   - en producción (NODE_ENV=production) el endpoint responde 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mercadito UM <no-reply@um.edu.mx>

# ─── Envío de SMS (OTP de cuenta externa) ─────────────────────
# Pendiente de contratar. Mismo comportamiento que SMTP si falta.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Pagos con Mercado Pago ────────────────────────────────────
# Interruptor global: mientras no sea el valor exacto 'true', el paso de
# "conectar cuenta de cobros" NO se exige para verificar ninguna cuenta
# (negocio, estudiante, externo) y el resto de endpoints de /api/payments
# siguen respondiendo 503 igual que si faltaran credenciales. Ver
# backend/src/payments/config.js (mercadoPagoHabilitado) y
# backend/src/validation/requisitosVerificacion.js.
#
# TODO: Mercado Pago pendiente para próxima actualización - poner en 'true'
# junto con reactivar kMercadoPagoHabilitado en el frontend
# (lib/features/payments/mercado_pago_flag.dart).
MERCADO_PAGO_HABILITADO=false

# Ver backend/src/payments/config.js. Nunca poner valores reales aquí.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
PAYMENTS_ENCRYPTION_KEY=
APP_PUBLIC_URL=
APP_DEEP_LINK_SCHEME=mercaditoum
MP_CURRENCY=MXN
PLATFORM_FEE_PERCENT=

# Cobrar SIN comisión de plataforma. Solo para probar la integración: apaga
# el split para aislar "¿el cobro funciona?" de "¿el reparto funciona?".
# Se apaga únicamente con el valor exacto 'false'; cualquier otra cosa
# (vacío, 'no', un typo) deja la comisión puesta, porque apagarla por
# accidente no da ningún error y no se nota hasta cuadrar las cuentas.
PLATFORM_FEE_ENABLED=true

# DÉJALA VACÍA. Salida de emergencia para forzar el `sandbox_init_point`.
#
# Al crear una preferencia, Mercado Pago devuelve los DOS enlaces, pero el
# bueno es siempre el normal (`init_point`), TAMBIÉN con credenciales de
# prueba: en pruebas lo que cambia son las cuentas y las tarjetas, no el
# host. Comprobado el 2026-08-14 abriendo una preferencia de un vendedor de
# prueba en www.mercadopago.com.mx: pinta el formulario y acepta la tarjeta
# de prueba. El entorno de sandbox ya no es un entorno aparte.
#
# Encenderla con 'true' manda al comprador a sandbox y su checkout se queda
# a medias. Está solo por si MP revive ese entorno.
MP_USE_SANDBOX_INIT_POINT=

# Traza detallada del flujo de pago: qué entra por el webhook, cómo se
# resuelve la orden, qué contestó Mercado Pago y qué se guardó. Las líneas
# salen marcadas [pagos][traza].
#
# Para cuando un pago "se hizo pero no aparece" y hay que saber en cuál de
# los seis pasos se rompió. Apagado por defecto: son ~8 líneas por
# notificación y MP reenvía cada evento varias veces. El estado final de
# cada orden y TODOS los fallos se registran siempre, con esto apagado.
#
# Se lee en cada llamada: basta 'pm2 restart mercadito-backend --update-env'.
DEBUG_PAGOS=false

# Volcar en el log el payload y la respuesta enteros de cada preferencia
# (~2 KB por pago, dos veces). Solo para perseguir un fallo del checkout de
# Mercado Pago. Lo imprescindible —qué cuenta cobra, qué enlace se entregó y
# todos los avisos— se registra siempre, con esto apagado.
MP_DEBUG_PREFERENCIA=false

# ─── Inicio de sesión con Google ────────────────────────────────
#
# Client ID de OAuth generados en Google Cloud Console. Se aceptan como
# audiencia (`aud`) válida del idToken que manda la app. Van los TRES
# separados por coma, porque el `aud` cambia según la plataforma desde la
# que se autenticó el usuario:
#
#   <Android>.apps.googleusercontent.com,<iOS>...,<Web>...
#
# El de Web es el imprescindible: es el `serverClientId` que la app pone en
# lib/config/google_auth_config.dart, y con el que Google firma el token
# destinado a este servidor.
#
# NO hace falta el Client Secret: este backend no intercambia códigos de
# autorización, solo verifica idToken ya emitidos contra las claves públicas
# de Google. Un secreto aquí sería un secreto de más que proteger.
#
# Mientras esté vacío, POST /api/auth/google responde 503
# GOOGLE_NO_CONFIGURADO y el login por correo y contraseña sigue igual.
GOOGLE_CLIENT_IDS=

# Restricción opcional por dominio de correo. Vacío = se acepta cualquier
# cuenta de Google (comportamiento por defecto, y el recomendado: negocios y
# particulares no tienen correo institucional; lo institucional se comprueba
# aparte, por OTP, en la verificación).
#
# Para dejar entrar SOLO a la comunidad UM:
#   GOOGLE_ALLOWED_DOMAINS=um.edu.mx,alumno.um.edu.mx
#
# Se compara el dominio completo, no un sufijo: 'um.edu.mx.otracosa.com' no
# pasa. Se lee en cada petición, así que basta reiniciar con --update-env.
GOOGLE_ALLOWED_DOMAINS=
